PORT=3000
# Origines autorisées (CORS), séparées par des virgules
FRONTEND_URL="http://localhost:5173"
# Temps de réponse avant réouverture automatique du buzzer (0 = jamais)
ANSWER_TIMEOUT_MS=15000
# Pénalité (ms) à chaque appui quand le buzzer est fermé
FALSE_START_PENALTY_MS=1500
# Suppression des rooms sans aucune connexion depuis ce délai
ROOM_TTL_MS=1800000
# Admin UI socket.io (https://admin.socket.io) : désactivée si vide. Mot de passe = hash bcrypt
ADMIN_UI_USERNAME=
ADMIN_UI_PASSWORD=
